		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/browser" type="text" width="512" height="28" bitmap="bitmaps/option_bkds" text="OPEN IN BROWSER" font="ui\large_ui" color="#FF2896FF" align="center" text_y="4">
		<on event="a" run="port mcc share browser"/>
		<on event="start" run="port mcc share browser"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/cancel" type="text" width="128" height="24" bitmap="bitmaps/text_button_background" text="CANCEL" font="ui\small_ui" color="#FFFFFFFF" align="center" text_y="2">
		<on event="a" run="port mcc share cancel"/>
		<on event="start" run="port mcc share cancel"/>
		<on event="left_mouse" run="mouse emit accept event"/>
