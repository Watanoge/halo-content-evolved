<?xml version="1.0" encoding="UTF-8"?>
<!-- The port's settings screen, in the PC version's style (tools/port_settings.py) -->
<menus>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/screen" type="column_list" width="640" height="480" bitmap="bitmaps/gradient" flags="pass_unhandled_to_focused_child up_down_tabs_children">
		<on event="b" run="port mcc share cancel"/>
		<on event="back" run="port mcc share cancel"/>
		<on event="deleted" run="port mcc share closed"/>
		<data input="port mcc share update"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/panel" x="10" y="-30"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/download" x="64" y="202"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/steam" x="64" y="230"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/workshop" x="64" y="258"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/browser" x="64" y="286"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/cancel" x="452" y="338"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/title"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/title" type="text" controller="1" left="35" top="11" width="400" height="59" text="MCC MAP DOWNLOAD" font="ui\large_ui" color="#FFFFFFFF" text_x="13" text_y="16">
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/panel" width="640" height="480" bitmap="bitmaps/controller_border">
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/map_title" x="66" y="116"/>
		<child widget="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/description" x="66" y="146"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/map_title" type="text" controller="1" width="488" height="28" font="ui\large_ui" color="#FFFFFFFF" text_flags="no_focus_test">
		<data input="port mcc share title"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/description" type="text" controller="1" width="488" height="84" font="ui\small_ui" color="#FFD2E1F0" text_flags="no_focus_test">
		<data input="port mcc share text"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/download" type="text" width="512" height="28" bitmap="bitmaps/option_bkds" text="DOWNLOAD FROM HOST" font="ui\large_ui" color="#FF2896FF" align="center" text_y="4">
		<on event="a" run="port mcc share download"/>
		<on event="start" run="port mcc share download"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/steam" type="text" width="512" height="28" bitmap="bitmaps/option_bkds" text="DOWNLOAD WITH STEAM" font="ui\large_ui" color="#FF2896FF" align="center" text_y="4">
		<on event="a" run="port mcc share steam"/>
		<on event="start" run="port mcc share steam"/>
		<on event="left_mouse" run="mouse emit accept event"/>
	</widget>
	<widget name="main_menu/settings_select/player_setup/player_profile_edit/network_setup/mcc_download/workshop" type="text" width="512" height="28" bitmap="bitmaps/option_bkds" text="OPEN IN STEAM" font="ui\large_ui" color="#FF2896FF" align="center" text_y="4">
